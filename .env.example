# Database (docker compose up -d)
DATABASE_URL="postgresql://smepay:smepay@localhost:5434/smepay?schema=public"

# Public base URL used for checkout links and provider callbacks
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-long-random-string"

# Bearer token required by /api/cron/settle (at least 32 characters, or the route always returns 401)
CRON_SECRET="change-me-long-random-string"

# bKash Tokenized Checkout (public sandbox credentials from bKash developer docs)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY="4f6o0cjiki2rfm34kfdadl1eqq"
BKASH_APP_SECRET="2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b"
BKASH_USERNAME="sandboxTokenizedUser02"
BKASH_PASSWORD="sandboxTokenizedUser02@12345"

# Nagad (sandbox credentials are issued by Nagad on request; leave empty to hide Nagad)
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_NUMBER=""
# Base64 key bodies without PEM headers
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""

# Show simulated card / Rocket / Upay providers (no public sandbox exists for these)
ENABLE_MOCK_PROVIDERS="true"
